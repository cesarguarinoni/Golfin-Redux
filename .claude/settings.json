{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"print('REMINDER: End your response with the file-summary table or next-step line. Do NOT append any sign-off, farewell, or catchphrase (no See you space cowboy, no goodbyes). The work output is the last line. See CLAUDE.md top-of-file rule.')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/enforce_implementer_done.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/route_subagent.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/route_subagent.py"
          }
        ]
      }
    ]
  }
}
