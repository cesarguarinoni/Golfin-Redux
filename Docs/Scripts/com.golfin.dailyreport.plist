<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GOLFIN Daily Report launchd agent.
  POLL MODEL (2026-07-15): runs daily_report.py every 30 min (StartInterval). The
  SCRIPT decides when to actually send — only at/after 20:30 (SEND_AFTER), and it
  dedupes so only the FIRST poll in the evening window posts; the rest are no-ops.
  We moved off StartCalendarInterval because its 20:30 trigger no-showed three
  weekday evenings running even while the Mac was awake and armed (only ever
  firing as a useless ~03:30 catch-up). A 30-min poll has no single instant to
  miss and needs no calendar re-arm. Weekend skip + send-window + dedupe all live
  in the script, so this plist is dumb-on-purpose. See DAILY_REPORT_SETUP.md §4.

  Install (see DAILY_REPORT_SETUP.md):
    cp Docs/Scripts/com.golfin.dailyreport.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.golfin.dailyreport.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.golfin.dailyreport.plist

  Run it right now (manual trigger):  launchctl start com.golfin.dailyreport
  Logs:  Docs/Scripts/daily_report.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.golfin.dailyreport</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/cesar/Documents/GolfinRedux/Docs/Scripts/.venv/bin/python</string>
        <string>/Users/cesar/Documents/GolfinRedux/Docs/Scripts/daily_report.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/cesar/Documents/GolfinRedux</string>

    <!-- Poll every 10 min (600s). The script gates the actual send to >= 20:30 and
         dedupes so only the first evening poll posts (so the report lands within
         ~10 min of 20:30). Daytime/weekend polls return silently — no log spam.
         See the header note. -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/cesar/Documents/GolfinRedux/Docs/Scripts/daily_report.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cesar/Documents/GolfinRedux/Docs/Scripts/daily_report.log</string>
</dict>
</plist>
