# GOLFIN Daily Report — environment template.
# Copy this to `.env` (same folder) and fill in real values. `.env` is gitignored.
#
#   cp Docs/Scripts/.env.example Docs/Scripts/.env
#
# Required ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# Optional ------------------------------------------------------------------
# Repo path: defaults to two levels up from daily_report.py, so usually unneeded.
# GOLFIN_REPO_PATH=/Users/cesar/Documents/GolfinRedux

# Media drop folder: defaults to <repo>/Docs/Reports/Media. Override if desired.
# GOLFIN_REPORT_MEDIA_DIR=/Users/cesar/Documents/GolfinRedux/Docs/Reports/Media

# Notion integration (leave blank to skip the task-tracker section).
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=...
# NOTION_TASK_NAME_COLUMN=Name
# NOTION_STATUS_COLUMN=Status
