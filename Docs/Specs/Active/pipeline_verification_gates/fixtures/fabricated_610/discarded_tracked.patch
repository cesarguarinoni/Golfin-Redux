             return PurchaseResult.Success;
         }
+
+        // ─── Order 610: ball purchase ─────────────────────────────────────────────
+
+        /// <summary>
+        /// Purchases one unit of the given ball type.
+        /// Increments <c>SaveData.ballQuantities[ballId]</c> unless quantity == -1 (unlimited).
+        /// Always succeeds on RP-check pass; balls are quantity-stacking, no ownership guard.
+        /// </summary>
+        /// <param name="ballId">Ball ID key (e.g. "ball_golfin"). Must be non-empty.</param>
+        /// <param name="rpCost">RP to debit.</param>
+        /// <param name="onGranted">Optional callback invoked AFTER grant.</param>
+        public static PurchaseResult TryPurchaseBall(
+            string ballId,
+            int rpCost,
+            Action onGranted = null)
+        {
+            if (string.IsNullOrEmpty(ballId))
+            {
+                Debug.LogWarning("[ShopTransaction] TryPurchaseBall: ballId is null or empty.");
+                return PurchaseResult.Invalid;
+            }
+
+            var rpm = RewardPointsManager.Instance;
+            if (rpm == null || !rpm.SpendPoints(rpCost))
+            {
+                Debug.Log(string.Format("[ShopTransaction] TryPurchaseBall: insufficient RP (need {0}).", rpCost));
+                return PurchaseResult.InsufficientRp;
+            }
+
+            // Increment quantity in save (respect -1 = unlimited sentinel)
+            var sdh = SaveDataHost.Instance;
+            if (sdh != null)
+            {
+                var save = sdh.Data;
+                if (save.ballQuantities.TryGetValue(ballId, out int qty))
+                {
+                    if (qty != -1) // -1 = unlimited; don't increment
+                        save.ballQuantities[ballId] = qty + 1;
+                }
+                else
+                {
+                    save.ballQuantities[ballId] = 1;
+                }
+                sdh.MarkDirty();
+            }
+            else
+            {
+                Debug.LogWarning("[ShopTransaction] TryPurchaseBall: SaveDataHost.Instance is null — ball not persisted.");
+            }
+
+            onGranted?.Invoke();
+            return PurchaseResult.Success;
+        }
+
+        // ─── Order 610: club purchase ─────────────────────────────────────────────
+
+        /// <summary>
+        /// Purchases the given club. Delegates to <c>ClubManager.GrantClub</c>.
+        /// Returns <see cref="PurchaseResult.AlreadyOwned"/> if the club is already in the
+        /// player's ownedClubs — caller should disable/hide the BUY button at that point.
+        /// Returns <see cref="PurchaseResult.Invalid"/> if clubId is not found in the DB.
+        /// </summary>
+        /// <param name="clubId">Club ID key (e.g. "club_driver_gf").</param>
+        /// <param name="rpCost">RP to debit.</param>
+        /// <param name="onGranted">Optional callback invoked AFTER grant.</param>
+        public static PurchaseResult TryPurchaseClub(
+            string clubId,
+            int rpCost,
+            Action onGranted = null)
+        {
+            if (string.IsNullOrEmpty(clubId))
+            {
+                Debug.LogWarning("[ShopTransaction] TryPurchaseClub: clubId is null or empty.");
+                return PurchaseResult.Invalid;
+            }
+
+            // Check ownership first (free — no RP debit yet)
+            var cm = ClubManager.Instance;
+            if (cm != null && cm.IsOwned(clubId))
+            {
+                Debug.Log(string.Format("[ShopTransaction] TryPurchaseClub: {0} already owned.", clubId));
+                return PurchaseResult.AlreadyOwned;
+            }
+
+            // RP spend
+            var rpm = RewardPointsManager.Instance;
+            if (rpm == null || !rpm.SpendPoints(rpCost))
+            {
+                Debug.Log(string.Format("[ShopTransaction] TryPurchaseClub: insufficient RP (need {0}).", rpCost));
+                return PurchaseResult.InsufficientRp;
+            }
+
+            // Grant
+            if (cm == null)
+            {
+                Debug.LogWarning("[ShopTransaction] TryPurchaseClub: ClubManager.Instance is null.");
+                // Refund RP since grant didn't happen
+                RewardPointsManager.Instance?.EarnPoints(rpCost);
+                return PurchaseResult.Invalid;
+            }
+
+            var grantResult = cm.GrantClub(clubId);
+            if (grantResult == ClubManager.GrantResult.ClubNotFound)
+            {
+                // Refund RP
+                RewardPointsManager.Instance?.EarnPoints(rpCost);
+                return PurchaseResult.Invalid;
+            }
+            if (grantResult == ClubManager.GrantResult.AlreadyOwned)
+            {
+                // Race: another path granted between IsOwned check and GrantClub — refund + report
+                RewardPointsManager.Instance?.EarnPoints(rpCost);
+                return PurchaseResult.AlreadyOwned;
+            }
+
+            onGranted?.Invoke();
+            return PurchaseResult.Success;
+        }
     }
