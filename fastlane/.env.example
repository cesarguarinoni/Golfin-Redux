# GOLFIN Redux — App Store Connect API key, for `bundle exec fastlane ios testflight_build`.
#
# Copy to fastlane/.env (gitignored) and fill in. fastlane loads fastlane/.env automatically.
# NEVER commit the real .env, and NEVER put the .p8 inside the repo — .gitignore blocks *.p8
# and fastlane/.env, but the safe home for the key is outside the working copy entirely.
#
# WHERE THE VALUES COME FROM
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect API -> "+"
#   (Cesar is Admin; Admin or Account Holder is required to mint a key.)
#     - Key ID     : shown in the key row after creation          -> ASC_KEY_ID
#     - Issuer ID  : shown once above the key table, per team     -> ASC_ISSUER_ID
#     - .p8 file   : DOWNLOADS EXACTLY ONCE and can never be re-downloaded.
#                    If it is lost, revoke the key and make a new one.
#                    Suggested home:  ~/.appstoreconnect/AuthKey_<KEYID>.p8
#                    Lock it down:    chmod 600 ~/.appstoreconnect/AuthKey_<KEYID>.p8
#
# Access level: "App Manager" is enough for TestFlight uploads. "Admin" also works.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/Users/cesar/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
