# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML — keep LF, use smart merge driver when available
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicsMaterial2D text eol=lf
*.spriteatlas text eol=lf
*.renderTexture text eol=lf

# TMP Font Assets — binary (contain embedded glyph atlas; CRLF conversion breaks them)
Assets/Fonts/*.asset binary
Assets/Fonts/*.asset.meta text eol=lf

# Other binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tiff binary
*.bmp binary
*.exr binary
*.hdr binary
*.mp3 binary
*.wav binary
*.ogg binary
*.fbx binary
*.obj binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.unitypackage binary
