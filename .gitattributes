# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML — keep LF + UnityYAMLMerge smart merge driver (configured per-machine in .git/config; see Docs/Specs/Queued/demo/DEMO_BUILD_PLAN.md §2.2)
*.unity merge=unityyamlmerge text eol=lf
*.prefab merge=unityyamlmerge text eol=lf
*.asset merge=unityyamlmerge text eol=lf
*.mat merge=unityyamlmerge text eol=lf
*.anim merge=unityyamlmerge text eol=lf
*.controller merge=unityyamlmerge text eol=lf
*.overrideController merge=unityyamlmerge text eol=lf
*.physicsMaterial2D merge=unityyamlmerge text eol=lf
*.spriteatlas merge=unityyamlmerge text eol=lf
*.renderTexture merge=unityyamlmerge text eol=lf

# TMP Font Assets — binary (contain embedded glyph atlas; CRLF conversion breaks them)
Assets/Fonts/*.asset binary
Assets/Fonts/*.asset.meta text eol=lf

# Other binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tiff binary
*.bmp binary
*.exr binary
*.hdr binary
*.mp3 binary
*.wav binary
*.ogg binary
*.fbx binary
*.obj binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.unitypackage binary

# Unity BINARY assets (cup_capture_and_lipout cleanup, 2026-08-06): TerrainData and
# LightingData serialize as BINARY even in force-text projects. The `* text=auto` +
# `*.asset text eol=lf` rules above make git run CRLF normalization over their raw bytes,
# so they compare as perpetually "modified" (and would be CORRUPTED if ever re-added:
# the clean filter strips 0x0D bytes from binary data). Mark them binary; overrides win
# because later lines take precedence.
TerrainData_*.asset binary
*Terrain.asset binary
LightingData.asset binary
