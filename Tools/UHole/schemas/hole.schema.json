{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/hole.schema.json",
  "title": "Hole Package",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "hole_number",
    "par",
    "stroke_index",
    "tee_yardages",
    "tee_sets",
    "review_status",
    "geometry_status",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "hole_number": {
      "type": "integer",
      "minimum": 1
    },
    "display_name": {
      "type": "string"
    },
    "par": {
      "type": "integer",
      "minimum": 1
    },
    "stroke_index": {
      "type": "integer",
      "minimum": 1
    },
    "tee_yardages": {
      "type": "object",
      "required": [
        "source_id",
        "entries"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tee_name",
              "yards"
            ],
            "properties": {
              "tee_name": {
                "type": "string"
              },
              "yards": {
                "type": "integer",
                "minimum": 1
              },
              "meters": {
                "type": "number",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "tee_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "yards"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "yards": {
            "type": "integer",
            "minimum": 1
          },
          "meters": {
            "type": "number",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "raw",
        "ingested",
        "reviewed",
        "production_candidate"
      ]
    },
    "geometry_status": {
      "type": "string",
      "enum": [
        "missing",
        "reference_only",
        "auto_generated",
        "reviewed"
      ]
    },
    "local_origin": {
      "type": "object",
      "properties": {
        "crs": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "unity_forward_degrees": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "derived_metrics": {
      "type": "object",
      "properties": {
        "centerline_length_m": {
          "type": "number"
        },
        "elevation_min_m": {
          "type": "number"
        },
        "elevation_max_m": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": [
        "official_references"
      ],
      "properties": {
        "official_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layout_geojson": {
          "type": "string"
        },
        "centerline_geojson": {
          "type": "string"
        },
        "hazards_geojson": {
          "type": "string"
        },
        "dem_tif": {
          "type": "string"
        },
        "heightmap_png": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
