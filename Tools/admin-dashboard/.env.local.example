# GOLFIN Admin Dashboard — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase project (server-side) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# service_role key — SERVER-SIDE ONLY. Grants full DB access; keep secret.
# Leaving this empty makes the app run in MOCK MODE (local fixtures, no network).
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin allowlist (comma-separated emails) ---
# Signed-in users not on this list are shown a "not an admin" page.
ADMIN_EMAILS=cesar.guarinoni@wonderwall-g.com,cesar.guarinoni@gmail.com

# --- Force mock mode even if a service key is set (optional) ---
# MOCK_MODE=1

# --- Mock mode in a PRODUCTION build (Cloudflare) ---
# Mock mode's login accepts ANY password. In a production build the app now
# REFUSES TO SERVE if it falls into mock mode — which is what happens when
# SUPABASE_SERVICE_ROLE_KEY is missing. That is deliberate: a silent fallback
# would put a "log in with anything" panel on admin.golfin.world. Set this only
# if you genuinely want fixtures in a production build.
# ALLOW_MOCK_MODE=1
