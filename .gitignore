# =========================
# Local Config
# =========================
.mcp.json
# Personal cloud-config backups (.mcp.json.cloud.bak etc.) contain local
# bearer tokens — must never be pushed.
.mcp.json*.bak

# Per-machine Claude Code config — settings.local.json holds machine-specific
# permission rules (Windows paths, etc.); skills/ is auto-generated by
# unity-mcp-cli from each machine's local Unity-MCP plugin config.
.claude/settings.local.json
.claude/skills/
# Per-machine git worktrees (created by Claude Code's worktree isolation)
.claude/worktrees/
# Per-machine Claude Code memory storage (path-keyed, never read from repo)
.claude/projects/

# =========================
# Unity Generated Folders
# =========================

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
Recordings/
UserSettings/

# =========================
# Memory Captures
# =========================

MemoryCaptures/

# =========================
# Visual Studio / Rider
# =========================

.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb

# =========================
# OS Files
# =========================

.DS_Store
Thumbs.db

# =========================
# Addressables
# =========================

ServerData/

# =========================
# Crash Reports
# =========================

sysinfo.txt

# =========================
# Android / iOS Builds
# =========================

.gradle/
*.apk
*.aab
*.keystore
.claude/worktrees/kind-haslett/

# =========================
# Screenshots (local review only)
# =========================

Assets/Screenshots/

# =========================
# Node.js (Tools/)
# =========================

**/node_modules/

# =========================
# Huge assets (over GitHub's 100MB limit or re-downloadable)
# =========================

# Third-party asset packs (re-downloadable from Asset Store)
Assets/Packs/

# Generated course scenes (regenerated from terrain data)
# Use /* (not trailing /) so negation rules for Experimental/ are still evaluated
Assets/Golf/Courses/*/Generated/*
!Assets/Golf/Courses/*/Generated/Experimental/
!Assets/Golf/Courses/*/Generated/Experimental/**

# Original imported scene lightmaps & reflection probes
Assets/Scenes/Original/

# Large binary source files
*.unitypackage
*.psd
*.tga
*.TGA
*.exr
*.EXR

# Bot demo-video transient artifacts (BotFrameRecorder → build_bot_video.py)
Docs/Diagnostics/_capture/botframe_*.png
tasks/loop_v2_smoke_bot/*/video/

# Session-local lock/sentinel files dropped into _capture/ by smoke runners.
# These should never have been tracked (rolled back in dae6f451, 2026-05-26).
Docs/Diagnostics/_capture/*.flag
Docs/Diagnostics/_capture/*.flag.pre

# =========================
# Daily Report tool (Docs/Scripts/daily_report.py)
# =========================
# Secrets (.env) and the per-machine venv must never be committed.
Docs/Scripts/.env
Docs/Scripts/.venv/
Docs/Scripts/daily_report.log
# Media drop folder: contents are transient (auto-deleted after send).
# Keep only the scaffold.
Docs/Reports/Media/*
!Docs/Reports/Media/README.md
!Docs/Reports/Media/.gitkeep
