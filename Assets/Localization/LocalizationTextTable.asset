    japanese: "3\u301C20\u6587\u5B57\u3001\u82F1\u6570\u5B57\u3068\u30A2\u30F3\u30C0\u30FC\u30B9\u30B3\u30A2\u304C\u4F7F\u3048\u307E\u3059"
  - key: AUTH_CREATE_USERNAME_BODY
    english: Please choose a username.\n\nYour username is public and used across
      all Golfin services to interact with the community.\n\nYour username can only
      contain letters and numbers.
    japanese: "\u30E6\u30FC\u30B6\u30FC\u540D\u3092\u6C7A\u3081\u3066\u304F\u3060\u3055\u3044\u3002\\n\\n\u30E6\u30FC\u30B6\u30FC\u540D\u306F\u516C\u958B\u3055\u308C\u3001Golfin\u306E\u3059\u3079\u3066\u306E\u30B5\u30FC\u30D3\u30B9\u3067\u30B3\u30DF\u30E5\u30CB\u30C6\u30A3\u3068\u306E\u4EA4\u6D41\u306B\u4F7F\u7528\u3055\u308C\u307E\u3059\u3002\\n\\n\u30E6\u30FC\u30B6\u30FC\u540D\u306B\u306F\u82F1\u6570\u5B57\u306E\u307F\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002"
  - key: AUTH_CREATE_USERNAME_PLACEHOLDER
    english: Username
    japanese: "\u30E6\u30FC\u30B6\u30FC\u540D"
