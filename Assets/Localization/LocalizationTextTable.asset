  - key: ROSTER_STARTER_INSTRUCTION
    english: CHOOSE YOUR STARTING CHARACTER. YOU WILL BE ABLE TO ACQUIRE NEW CHARACTERS
      THROUGHOUT THE GAME.
    japanese: "\u30B9\u30BF\u30FC\u30C8\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3092\u9078\u3093\u3067\u304F\u3060\u3055\u3044\u3002\u65B0\u3057\u3044\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306F\u30B2\u30FC\u30E0\u3092\u9032\u3081\u306A\u304C\u3089\u7372\u5F97\u3067\u304D\u307E\u3059\u3002"
  - key: ROSTER_STARTER_CONFIRM_TITLE
    english: 'YOU ARE STARTING THE GAME WITH:'
    japanese: "\u3053\u306E\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3067\u30B2\u30FC\u30E0\u3092\u958B\u59CB\u3057\u307E\u3059:"
  - key: ROSTER_STARTER_BACK
    english: BACK
    japanese: "\u623B\u308B"
  - key: ROSTER_LOCKED_ACQUIRE
    english: ACQUIRE THIS CHARACTER IN THE STORE OR AS A PRIZE TO UNLOCK IT.
    japanese: "\u3053\u306E\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306F\u30B7\u30E7\u30C3\u30D7\u307E\u305F\u306F\u5831\u916C\u3067\u7372\u5F97\u3059\u308B\u3068\u30A2\u30F3\u30ED\u30C3\u30AF\u3055\u308C\u307E\u3059\u3002"
