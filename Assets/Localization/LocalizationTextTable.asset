    japanese: "\u30B9\u30AF\u30EA\u30FC\u30F3\u30B7\u30E7\u30C3\u30C8\u306E\u9078\u629E\u306B\u306F\u5199\u771F\u3078\u306E\u30A2\u30AF\u30BB\u30B9\u8A31\u53EF\u304C\u5FC5\u8981\u3067\u3059\u3002"
  - key: GPS_ERR_SERVICE_DISABLED
