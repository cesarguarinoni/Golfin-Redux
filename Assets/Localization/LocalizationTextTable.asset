    english: Enter your email first.
    japanese: "\u5148\u306B\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  - key: AUTH_LOGIN_RESET_SENT
    english: Password reset email sent.
    japanese: "\u30D1\u30B9\u30EF\u30FC\u30C9\u518D\u8A2D\u5B9A\u30E1\u30FC\u30EB\u3092\u9001\u4FE1\u3057\u307E\u3057\u305F\u3002"
  - key: AUTH_SIGNUP_ERR_MISSING_EMAIL
    english: Enter your email address.
