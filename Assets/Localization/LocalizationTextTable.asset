    english: Or
    japanese: "\u307E\u305F\u306F"
  - key: AUTH_SIGNUP_HAVE_ACCOUNT
    english: If you already have an account, <color=#22b800><b>login here</b></color>
    japanese: "\u3059\u3067\u306B\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u304A\u6301\u3061\u306E\u65B9\u306F\u3001<color=#22b800><b>\u3053\u3061\u3089\u304B\u3089\u30ED\u30B0\u30A4\u30F3</b></color>"
