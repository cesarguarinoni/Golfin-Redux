    english: CANCEL
    japanese: "\u30AD\u30E3\u30F3\u30BB\u30EB"
  - key: BAG_EQUIPPED
    english: EQUIPPED
    japanese: "\u88C5\u5099\u4E2D"
  - key: BAG_EQUIP
    english: EQUIP
    japanese: "\u88C5\u5099"
