    japanese: "\u30E1\u30FC\u30EB"
  - key: AUTH_SIGNUP_PASSWORD_PLACEHOLDER
    english: Password
    japanese: "\u30D1\u30B9\u30EF\u30FC\u30C9"
  - key: AUTH_SIGNUP_BUTTON
    english: CREATE
    japanese: "\u4F5C\u6210"
  - key: AUTH_SIGNUP_GOOGLE
    english: Sign up with Google
    japanese: "Google\u3067\u767B\u9332"
  - key: AUTH_SIGNUP_APPLE
    english: Sign up with Apple
    japanese: "Apple\u3067\u767B\u9332"
