  - key: INGAME_QUIT_CONFIRM_BODY
    english: YOU WILL NOT GET ANY REWARDS WHEN QUITTING.
    japanese: "\u9014\u4E2D\u3067\u7D42\u4E86\u3059\u308B\u3068\u5831\u916C\u306F\u7372\u5F97\u3067\u304D\u307E\u305B\u3093\u3002"
