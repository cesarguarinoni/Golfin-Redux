    japanese: "\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9"
  - key: AUTH_SIGNUP_PASSWORD_LABEL
    english: PASSWORD
    japanese: "\u30D1\u30B9\u30EF\u30FC\u30C9"
